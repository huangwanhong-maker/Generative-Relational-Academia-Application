node_modules/
dist/
*.tsbuildinfo

# The server's working data: records are files, and they are the record.
# They belong to whoever runs the server, not in this repository.
data/

# The index is rebuildable from the records by construction (C11). Losing it
# costs a reindex and nothing else, which is the property that keeps the
# database from quietly becoming the system of record.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

.env
.env.local
